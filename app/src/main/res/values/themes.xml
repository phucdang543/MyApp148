<resources>

    <style name="Base.Theme.MyApp" parent="Theme.Material3.DayNight">


    </style>

    <style name="Theme.MyApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar"/>

    <style name="NavigationItemShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ModernButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:fontFamily">@font/sf_pro_text_semibold</item>
    </style>

    <style name="ModernCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <style name="ModernEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="android:fontFamily">@font/sf_pro_display_regular</item>
    </style>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/apple_red</item>
        <item name="colorPrimaryVariant">@color/apple_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/apple_purple</item>
        <item name="colorSecondaryVariant">@color/apple_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorSurface">@color/glass_card</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppleNavigationItemShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="AppleTextStyle">
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/sf_pro_display_regular</item>
    </style>

    <style name="AppleTextStyle.Title" parent="AppleTextStyle">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/sf_pro_display_heavy</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="AppleTextStyle.Subtitle" parent="AppleTextStyle">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/apple_gray_light</item>
        <item name="fontFamily">@font/sf_pro_display_medium</item>
    </style>

    <style name="AppleTextStyle.Body" parent="AppleTextStyle">
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">@font/sf_pro_display_regular</item>
    </style>

    <style name="AppleTextStyle.Caption" parent="AppleTextStyle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/apple_gray</item>
        <item name="fontFamily">@font/sf_pro_display_regular</item>
    </style>

    <style name="AppleButton" parent="Widget.Material3.Button">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/sf_pro_text_semibold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/apple_blue</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="AppleButton.Primary" parent="AppleButton">
        <item name="backgroundTint">@color/apple_blue</item>
    </style>

    <style name="AppleButton.Secondary" parent="AppleButton">
        <item name="backgroundTint">@color/glass_card</item>
        <item name="android:textColor">@color/apple_blue</item>
    </style>

    <style name="AppleCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/glass_card</item>
    </style>

    <style name="AppleCard.Large" parent="AppleCard">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">8dp</item>
    </style>

    <style name="AppleEditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/apple_gray</item>
        <item name="fontFamily">@font/sf_pro_display_regular</item>
        <item name="android:background">@color/glass_input</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="AppleToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/AppleTextStyle.Title</item>
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark</item>
    </style>

    <style name="AppleBottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="itemIconTint">@color/apple_nav_selector</item>
        <item name="itemTextColor">@color/apple_nav_selector</item>
        <item name="itemRippleColor">@color/apple_blue</item>
        <item name="labelVisibilityMode">selected</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">4dp</item>
    </style>

    <style name="AppleNavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">@color/drawer_background_dark</item>
        <item name="itemIconTint">@color/apple_nav_drawer_selector</item>
        <item name="itemTextColor">@color/apple_nav_drawer_selector</item>
        <item name="itemShapeAppearance">@style/AppleNavigationItemShape</item>
        <item name="android:elevation">24dp</item>
    </style>

    <style name="AppleFAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/apple_purple</item>
        <item name="tint">@color/white</item>
        <item name="android:elevation">16dp</item>
        <item name="borderWidth">0dp</item>
    </style>

    <style name="AppleProgressBar" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/apple_red</item>
        <item name="trackColor">@color/glass_light</item>
        <item name="indicatorSize">36dp</item>
        <item name="trackThickness">4dp</item>
    </style>

    <style name="AppleSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/apple_seekbar_progress</item>
        <item name="android:thumb">@drawable/apple_seekbar_thumb</item>
        <item name="android:maxHeight">6dp</item>
        <item name="android:minHeight">6dp</item>
    </style>

    <style name="AppleDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:background">@drawable/apple_dialog_background</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:colorBackground">@color/glass_card</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppleSwitch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/apple_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppleChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/glass_card</item>
        <item name="chipStrokeColor">@color/apple_blue</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipCornerRadius">20dp</item>
    </style>

    <style name="AppleRecyclerView">
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbars">none</item>
        <item name="android:fadeScrollbars">true</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
    </style>

    <style name="AppleMusicDialogTheme" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowTitleStyle">@null</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>